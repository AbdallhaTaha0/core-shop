# Safe placeholders only — never commit a real .env with secrets.
NODE_ENV=development
PORT=3000
# Host-side development against `docker compose up db`.
DATABASE_URL=postgres://coreshop:coreshop-dev-only@localhost:5432/coreshop
# Must be the exact future frontend origin; never a wildcard in production.
FRONTEND_ORIGIN=http://localhost:5173
# Consumed by the auth domain for cookie JWTs. Required in every environment.
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=15m
# Isolated test database for `npm test` (defaults to coreshop_test on 5432).
# Override when the DB listens elsewhere, e.g. DB_HOST_PORT=5433:
# TEST_DATABASE_URL=postgres://coreshop:coreshop-dev-only@localhost:5433/coreshop_test

# --- Back4app + Neon (production) ---
# Set these as Environment Variables in the Back4app dashboard, NOT in a file:
#   NODE_ENV=production
#   DATABASE_URL=<Neon pooled connection string, must end with ?sslmode=require>
#     e.g. postgres://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#     Use the pooled (pooler) host for serverless/edge-friendly connections.
#   FRONTEND_ORIGIN=<exact frontend URL, e.g. https://my-app.back4app.io>
#   JWT_SECRET=<long random string, min 32 chars — generate a fresh one>
#   JWT_EXPIRES_IN=15m
# Do NOT set PORT manually — Back4app injects it. Do NOT set TEST_DATABASE_URL.
# Back4app app settings (single container): Root directory = ./ (repo-root
# Dockerfile builds client + server), Health check path = /api/v1/health,
# FRONTEND_ORIGIN = the app's own public URL (same-origin serving).
# Single-container root deploy (repo-root Dockerfile): CLIENT_DIST_DIR is set
# inside the image (ENV CLIENT_DIST_DIR=/app/client). Leave it unset locally —
# `npm run dev` serves the API only and Vite serves the frontend on :5173.
# CLIENT_DIST_DIR=
